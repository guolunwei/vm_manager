# 复制为 .env 后按需取消注释。优先级：环境变量 > .env > config.ini > 默认值。
# 每一项都可以不填 —— 不填就走 config.ini 或自动探测。

# ---- 路径 -------------------------------------------------------------------
# VMM_BASE_DIR=D:\Virtual Machines
# VMM_VMRUN=D:\Applications\VMware\VMware Workstation\vmrun.exe
# VMM_TEMPLATE_VMX=D:\Virtual Machines\CentOS7_cloud\CentOS7_cloud.vmx
# VMM_SNAPSHOT=init

# ---- Guest ------------------------------------------------------------------
# VMM_GUEST_USER=root
# VMM_GUEST_PASSWORD=模板里 root 的密码
# VMM_GUEST_CONNECTION=eth0
# 要下发到客户机的公钥；不填则用运行进程账号的 ~/.ssh/*.pub
# VMM_SSH_PUBKEY=ssh-ed25519 AAAA...

# ---- 网络 -------------------------------------------------------------------
# 留空时从 VMware 的 vmnetdhcp.conf 自动推断（host-only → VMnet1，NAT → VMnet8）
# VMM_GATEWAY=192.168.47.1
# VMM_DNS=192.168.47.1
# VMM_NETMASK_PREFIX=24
# VMM_SCAN_ENABLED=1
# VMM_SCAN_TIMEOUT_MS=500

# ---- 默认规格 ---------------------------------------------------------------
# VMM_DEFAULT_CPUS=2
# VMM_DEFAULT_MEMORY_MB=4096

# ---- 运行参数 ---------------------------------------------------------------
# VMM_JOB_TIMEOUT=1800
# VMM_TOOLS_WAIT=360
# VMM_WORKER_HEARTBEAT=10
# VMM_WORKER_STALE_AFTER=120
# VMM_SOFT_STOP_GRACE=60

# ---- Web --------------------------------------------------------------------
# 生产环境（config.settings.prod）必改
# DJANGO_SECRET_KEY=换成一串随机字符
# DJANGO_ALLOWED_HOSTS=vm.example.com,127.0.0.1
# 反向代理终止 TLS 时打开
# VMM_TRUST_PROXY=1
# VMM_HTTPS_ONLY=1
